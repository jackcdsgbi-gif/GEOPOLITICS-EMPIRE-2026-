{
  "name": "dollar-doctrine-multiplayer",
  "version": "1.0.0",
  "description": "Multiplayer server for Dollar Doctrine — geopolitical idle tycoon",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tunnel": "npx localtunnel --port 4000",
    "tunnel:cf": "cloudflared tunnel --url http://localhost:4000",
    "reset-db": "node -e \"require('fs').rmSync('./data', {recursive:true, force:true})\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5"
  },
  "license": "MIT"
}
